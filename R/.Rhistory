# 3. Uygulamayı ayağa kaldır
shinyApp(ui = ui, server = server)
install.packages("shiny")
# 1. Gerekli paketi çağırıyoruz
library(shiny)
# --- SENİN BAZ KODLARIN ---
learning_ui <- function(id) {
ns <- NS(id)
tagList(
sliderInput(ns("L"), "Learning Curve", 0.6, 0.99, 0.8),
plotOutput(ns("grafik"))
)
}
learning_server <- function(id) {
moduleServer(id, function(input, output, session) {
output$grafik <- renderPlot({
b <- -log(input$L) / log(2)
u <- 1:50
# Eksen ismindeki ufak hatayı "Süre" olarak düzelttim
plot(u, 100 * u^(-b), type = "l", xlab = "Birim", ylab = "Süre",
col = "blue", lwd = 2, main = "Öğrenme Eğrisi Grafiği")
})
})
}
# --------------------------
# 2. Modülü çalıştıracak ANA UYGULAMA (Main App) yapısı
ui <- fluidPage(
titlePanel("Modül Test Ekranı"),
# Senin UI modülünü buraya çağırıyoruz. "test1" bu modülün kimliği (id).
learning_ui("test1")
)
server <- function(input, output, session) {
# Senin Server modülünü buraya çağırıyoruz. Kimlik aynı olmalı ("test1").
learning_server("test1")
}
# 3. Uygulamayı ayağa kaldır
shinyApp(ui = ui, server = server)
learning_ui <- function(id) {
ns <- NS(id)
tagList(
sliderInput(ns("L"), "Learning Curve", 0.6, 0.99, 0.8),
plotOutput(ns("grafik"))
)
}
learning_server <- function(id) {
moduleServer(id, function(input, output, session) {
output$grafik <- renderPlot({
b <- -log(input$L) / log(2)
u <- 1:50
plot(u, 100 * u^(-b), type = "l", xlab = "Birim", ylab = "SC<re")
})
})
}
plot(u, 100 * u^(-b), type = "l",col = "blue",xlim = c(1, 50),ylim = c(0, 100), xlab = "Birim", ylab = "Skor")
